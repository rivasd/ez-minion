# Versioned on purpose: Vite bundles VITE_* values into the public site,
# so nothing here is secret. Put private overrides in .env.local (gitignored).
VITE_UNLOCK_CODE=123
VITE_FINAL_CODE=456
# Path under /public. Drop the file at public/audio/minions.mp3
VITE_AUDIO_PATH=audio/minions.mp3

# Phrase revealed when the TEMPORISATION button puzzle is solved
VITE_TEMPO_PHRASE=REPLACE ME WITH THE REAL PHRASE
# The three differences in the room photo (public/photos/room.jpg), accepted in any order
VITE_PHOTO_ANSWER_1=answer one
VITE_PHOTO_ANSWER_2=answer two
VITE_PHOTO_ANSWER_3=answer three
# Clue revealed once all three differences are found
VITE_PHOTO_CLUE=REPLACE ME WITH THE FINAL CLUE



